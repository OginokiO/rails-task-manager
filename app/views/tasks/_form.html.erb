<%# Partial compartido para los formularios de new y edit.
    Se renderiza desde ambas vistas. Recibe una variable local `task`
    (pasada via locals desde las vistas que lo llaman).

    Usa task.new_record? para decidir si mostrar el campo "completed":
    - En new (task.new_record? == true) NO se muestra el campo completado,
      porque una tarea nueva aún no se puede marcar como completada.
    - En edit (task.new_record? == false) SÍ se muestra el campo completado. %>
<%= form_with model: task, class: "mt-3" do |form| %>
  <div class="mb-3">
    <%= form.label :title, class: "form-label" %><br>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :details, class: "form-label" %><br>
    <%= form.text_area :details, class: "form-control", rows: 4 %>
  </div>

  <% unless task.new_record? %>
  <div class="mb-3 form-check">
    <%= form.check_box :completed, class: "form-check-input" %>
    <%= form.label :completed, class: "form-check-label" %>
  </div>
  <% end %>

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
